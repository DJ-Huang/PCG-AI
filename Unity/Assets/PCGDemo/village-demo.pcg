{
  "version": "1.0",
  "nodes": [
    {
      "id": "grid",
      "type": "CreatePointGrid",
      "position": { "x": 320, "y": 0 },
      "data": {"pointCountX": 6, "pointCountY": 6, "spacing": 4}
    },
    {
      "id": "terrain",
      "type": "GetTerrainData",
      "position": { "x": 320, "y": 280 },
      "data": {"gridSize": 64, "cellSize": 1.5, "amplitude": 8, "seed": 1337}
    },
    {
      "id": "sample",
      "type": "SampleSurface",
      "position": { "x": 640, "y": 0 },
      "data": {"offsetY": 0.5, "blend": 0.8}
    },
    {
      "id": "delaunay",
      "type": "Delaunay",
      "position": { "x": 960, "y": -280 },
      "data": {"maxEdgeLength": 20}
    },
    {
      "id": "mst",
      "type": "MST",
      "position": { "x": 1280, "y": -280 },
      "data": {"maxEdgeLength": 15}
    },
    {
      "id": "astar",
      "type": "AStarPathfinding",
      "position": { "x": 1600, "y": -280 },
      "data": {"startIndex": 0, "endIndex": 35}
    },
    {
      "id": "voronoi",
      "type": "Voronoi",
      "position": { "x": 960, "y": 60 },
      "data": {"offsetY": 0.2, "maxEdgeLength": 20}
    },
    {
      "id": "density",
      "type": "DensityFilter",
      "position": { "x": 960, "y": 350 },
      "data": {"density": 0.7}
    },
    {
      "id": "transform",
      "type": "TransformPoints",
      "position": { "x": 1280, "y": 350 },
      "data": {"translateX": 0, "translateY": 0.5, "translateZ": 0, "scale": 1.2, "rotationY": 15}
    },
    {
      "id": "copyAttr",
      "type": "CopyAttributes",
      "position": { "x": 1600, "y": 350 },
      "data": {"attributeNames": "prefab,scale", "prefab": "building", "scale": 1.5}
    },
    {
      "id": "place",
      "type": "PlaceInScene",
      "position": { "x": 1920, "y": 350 },
      "data": {"prefab": "building", "scale": 1.5}
    },
    {
      "id": "box",
      "type": "CreateBoxMesh",
      "position": { "x": 0, "y": 650 },
      "data": {"width": 4, "height": 3, "depth": 4}
    },
    {
      "id": "subdiv",
      "type": "SubdivideMesh",
      "position": { "x": 320, "y": 650 },
      "data": {"levels": 2}
    },
    {
      "id": "bevel",
      "type": "BevelMesh",
      "position": { "x": 640, "y": 650 },
      "data": {"method": "edge", "offsetType": "offset", "amount": 0.12, "segments": 3, "clampOverlap": true}
    },
    {
      "id": "outPath",
      "type": "Output",
      "position": { "x": 1920, "y": -280 },
      "data": {"label": "Road Network"}
    },
    {
      "id": "outVoronoi",
      "type": "Output",
      "position": { "x": 1280, "y": 60 },
      "data": {"label": "Voronoi Cells"}
    },
    {
      "id": "outVillage",
      "type": "Output",
      "position": { "x": 2240, "y": 350 },
      "data": {"label": "Village Instances"}
    },
    {
      "id": "outMesh",
      "type": "Output",
      "position": { "x": 960, "y": 650 },
      "data": {"label": "Building Mesh"}
    },
    {
      "id": "spawn",
      "type": "SpawnPoints",
      "position": { "x": 0, "y": 0 },
      "data": {"count": 80, "radius": 15}
    }
  ],
  "edges": [
    {"id": "e1", "source": "spawn", "target": "grid", "sourceHandle": "out", "targetHandle": "in"},
    {"id": "e2", "source": "grid", "target": "sample", "sourceHandle": "out", "targetHandle": "in"},
    {"id": "e3", "source": "terrain", "target": "sample", "sourceHandle": "out", "targetHandle": "terrain"},
    {"id": "e4", "source": "sample", "target": "delaunay", "sourceHandle": "out", "targetHandle": "in"},
    {"id": "e5", "source": "delaunay", "target": "mst", "sourceHandle": "out", "targetHandle": "in"},
    {"id": "e6", "source": "sample", "target": "mst", "sourceHandle": "out", "targetHandle": "points"},
    {"id": "e7", "source": "mst", "target": "astar", "sourceHandle": "out", "targetHandle": "in"},
    {"id": "e8", "source": "sample", "target": "astar", "sourceHandle": "out", "targetHandle": "points"},
    {"id": "e9", "source": "sample", "target": "voronoi", "sourceHandle": "out", "targetHandle": "in"},
    {"id": "e10", "source": "sample", "target": "density", "sourceHandle": "out", "targetHandle": "in"},
    {"id": "e11", "source": "density", "target": "transform", "sourceHandle": "out", "targetHandle": "in"},
    {"id": "e12", "source": "transform", "target": "copyAttr", "sourceHandle": "out", "targetHandle": "in"},
    {"id": "e13", "source": "copyAttr", "target": "place", "sourceHandle": "out", "targetHandle": "in"},
    {"id": "e14", "source": "box", "target": "subdiv", "sourceHandle": "out", "targetHandle": "in"},
    {"id": "e15", "source": "subdiv", "target": "bevel", "sourceHandle": "out", "targetHandle": "in"},
    {"id": "e16", "source": "astar", "target": "outPath", "sourceHandle": "out", "targetHandle": "in"},
    {"id": "e17", "source": "voronoi", "target": "outVoronoi", "sourceHandle": "out", "targetHandle": "in"},
    {"id": "e18", "source": "place", "target": "outVillage", "sourceHandle": "out", "targetHandle": "in"},
    {"id": "e19", "source": "bevel", "target": "outMesh", "sourceHandle": "out", "targetHandle": "in"}
  ],
  "parameters": [
    {"id": "p-seed", "name": "Seed", "type": "integer", "default": 1337, "exposed": true, "targetNode": "terrain", "targetProperty": "seed", "hasRange": false, "min": 0, "max": 1},
    {"id": "p-density", "name": "Density", "type": "number", "default": 0.6, "exposed": true, "targetNode": "density", "targetProperty": "density", "hasRange": true, "min": 0, "max": 1},
    {"id": "p-spawnCount", "name": "Spawn Count", "type": "integer", "default": 80, "exposed": true, "targetNode": "spawn", "targetProperty": "count", "hasRange": true, "min": 10, "max": 500},
    {"id": "p-gridSpacing", "name": "Grid Spacing", "type": "number", "default": 4, "exposed": true, "targetNode": "grid", "targetProperty": "spacing", "hasRange": true, "min": 1, "max": 10},
    {"id": "p-buildScale", "name": "Building Scale", "type": "number", "default": 1.5, "exposed": true, "targetNode": "copyAttr", "targetProperty": "scale", "hasRange": true, "min": 0.5, "max": 3},
    {"id": "p-bevelAmount", "name": "Bevel Amount", "type": "number", "default": 0.12, "exposed": true, "targetNode": "bevel", "targetProperty": "amount", "hasRange": true, "min": 0, "max": 0.5}
  ]
}