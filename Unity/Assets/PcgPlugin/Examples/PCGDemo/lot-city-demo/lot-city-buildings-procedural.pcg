      "type": "AttributeWrangle",
      "position": { "x": 1438, "y": 2035.5 },
      "data": {"group": "", "groupType": "guess", "runOver": "detail", "expression": "int buildingIter = chi(\"buildingIter\");\n// find how many street facing edges\nint numStreetFacing = nedgesgroup(0, \"streetFacingEdges\");\n// if > 2, then has an available side for being a fire escape\n// also check if more than 2 floors, looks goofy on short buildings lol\nif(numStreetFacing >= 2 && @numFloors > 2 && rand(buildingIter*20) < 0.5)\n{\n  @hasFireEscape = 1;\n}\n// if too narrow for fire escape, then override\nfloat lengthSide = length(getbbox_size(1));\nif(lengthSide < 1.25) {\n  @hasFireEscape = 0;\n}", "parameters": "{\"buildingIter\":{\"expr\":\"@iteration\",\"value\":0}}", "attributesToCreate": "", "enforcePrototypes": false, "ramps": "{}", "__nodeTitle": "choose_fire_escape"}
