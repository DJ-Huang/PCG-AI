      "type": "AttributeWrangle",
      "position": { "x": 1438, "y": 2145.5 },
      "data": {"group": "", "groupType": "guess", "runOver": "detail", "expression": "int buildingIter = chi(\"buildingIter\");\n// find how many street facing edges\nint numStreetFacing = nedgesgroup(0, \"streetFacingEdges\");\n// if streetFacing > 2 and no fire escape, then has an available side for vines\nif(numStreetFacing >= 2 && @numFloors > 1 && @hasFireEscape==0 && rand(buildingIter*22) < 0.6) {\n  @hasVines = 1;\n}", "parameters": "{\"buildingIter\":{\"expr\":\"@iteration\",\"value\":0}}", "attributesToCreate": "", "enforcePrototypes": false, "ramps": "{}", "__nodeTitle": "choose_vines"}
