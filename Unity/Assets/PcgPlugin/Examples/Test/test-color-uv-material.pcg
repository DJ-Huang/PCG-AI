  "edges": [
    { "id": "e1", "source": "cyl", "target": "uv", "sourceHandle": "out", "targetHandle": "in" },
    { "id": "e2", "source": "uv", "target": "color", "sourceHandle": "out", "targetHandle": "in" },
    { "id": "e3", "source": "color", "target": "material", "sourceHandle": "out", "targetHandle": "in" },
