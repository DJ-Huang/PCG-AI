    {
      "id": "lib_pcg_lib_cable_cable_generator",
      "name": "Cable Generator",
      "inputs": [
        {
          "id": "path",
          "name": "Path",
          "pinType": "SpatialSpline"
        }
      ],
      "outputs": [
        {
          "id": "out",
          "name": "Geometry",
          "pinType": "SpatialGeometry"
        }
      ],
      "nodes": [
        {
          "id": "subgraph_input",
          "type": "SubgraphInput",
          "position": {
            "x": 200,
            "y": 0
          },
          "data": {}
        },
        {
          "id": "resample",
          "type": "ResampleSpline",
          "position": {
            "x": 200,
            "y": 160
          },
          "data": {
            "edgeMode": "unshared",
            "edgeGroup": "",
            "method": "evenLength",
            "measure": "arc",
            "useMaxSegmentLength": false,
            "maxSegmentLength": 1,
            "useMaxSegments": false,
            "maxSegments": 2,
            "evenLastSegmentSameLength": true,
            "maintainLastVertex": true,
            "writeCurveUAttr": false,
            "curveUAttribute": "curveu",
            "writeDistanceAttr": false,
            "distanceAttribute": "ptdist",
            "writeCurveNumAttr": false,
            "curveNumAttribute": "curvenum",
            "mode": "spacing",
            "spacing": 0.25,
            "pointCount": 32
          }
        },
        {
          "id": "sweep",
          "type": "SweepAlongSpline",
          "position": {
            "x": 200,
            "y": 320
          },
          "data": {
            "surfaceShape": "circle",
            "profileWidth": 6,
            "profileHeight": 0.4,
            "radius": 0.03,
            "columns": 8,
            "sampleSpacing": 1,
            "capStart": true,
            "capEnd": true,
            "upX": 0,
            "upY": 1,
            "upZ": 0,
            "twist": 0,
            "profileRoll": 0,
            "scaleStart": 1,
            "scaleEnd": 1,
            "profilePlane": "xy",
            "shadeMode": "smooth",
            "cuspAngle": 30
          }
        },
        {
          "id": "subgraph_output",
          "type": "SubgraphOutput",
          "position": {
            "x": 200,
            "y": 480
          },
          "data": {}
        }
      ],
      "edges": [
        {
          "id": "e1",
          "source": "subgraph_input",
          "target": "resample",
          "sourceHandle": "path",
          "targetHandle": "in",
          "sourcePinType": "SpatialSpline",
          "targetPinType": "Any"
        },
        {
          "id": "e2",
          "source": "resample",
          "target": "sweep",
          "sourceHandle": "out",
          "targetHandle": "backbone",
          "sourcePinType": "SpatialSpline",
          "targetPinType": "SpatialSpline"
        },
        {
          "id": "e3",
          "source": "sweep",
          "target": "subgraph_output",
          "sourceHandle": "out",
          "targetHandle": "out",
          "sourcePinType": "SpatialMesh",
          "targetPinType": "SpatialGeometry"
        }
      ],
      "parameters": [
        {
          "id": "segmentLength",
          "name": "Segment Length",
          "type": "number",
          "default": 0.25,
          "exposed": true,
          "targetNode": "resample",
          "targetProperty": "spacing",
          "hasRange": true,
          "min": 0.05,
          "max": 2
        },
        {
          "id": "thickness",
          "name": "Thickness",
          "type": "number",
          "default": 0.03,
          "exposed": true,
          "targetNode": "sweep",
          "targetProperty": "radius",
          "hasRange": true,
          "min": 0.002,
          "max": 0.5
        },
        {
          "id": "sides",
          "name": "Sides",
          "type": "integer",
          "default": 8,
          "exposed": true,
          "targetNode": "sweep",
          "targetProperty": "columns",
          "hasRange": true,
          "min": 3,
          "max": 32
        }
      ]
    }
  ]
}