    {
      "id": "scale_lot",
      "type": "AttributeWrangle",
      "position": {
        "x": 360,
        "y": 1680
      },
      "data": {
        "runOver": "points",
        "expression": "@protoX = (@variant == 0) * 3.7 + (@variant == 1) * 6.0 + (@variant == 2) * 3.8 + (@variant == 3) * 6.2 + (@variant == 4) * 4.5 + (@variant == 5) * 6.5; @protoZ = (@variant == 0) * 3.7 + (@variant == 1) * 3.7 + (@variant == 2) * 3.8 + (@variant == 3) * 3.8 + (@variant == 4) * 4.5 + (@variant == 5) * 4.2; @s = min(@sxLot * 0.88 / max(@protoX, 0.001), @szLot * 0.88 / max(@protoZ, 0.001)); @scaleX = @s; @scaleY = 1; @scaleZ = @s;",
