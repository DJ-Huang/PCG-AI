{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcg.example.com/subgraph-schema.json",
  "title": "PCG Linked Subgraph Asset",
  "description": "Versioned contract for linked .pcgsubgraph assets. Version 1.0 remains valid on disk; serializer output and migrated assets use version 2.0.",
  "oneOf": [
    { "$ref": "#/$defs/assetV1" },
    { "$ref": "#/$defs/assetV2" }
  ],
  "$defs": {
    "assetV1": {
      "type": "object",
      "required": ["version", "name", "inputs", "outputs", "nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "1.0" },
        "name": { "type": "string" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/subgraphPort" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/subgraphPort" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
        "subgraphs": { "type": "array", "items": { "$ref": "#/$defs/subgraph" } }
      }
    },
    "assetV2": {
      "type": "object",
      "required": ["version", "name", "contentHash", "inputs", "outputs", "parameters", "nodes", "edges", "subgraphs"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": "2.0" },
        "name": { "type": "string" },
        "contentHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/subgraphPort" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/subgraphPort" } },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
        "subgraphs": { "type": "array", "items": { "$ref": "#/$defs/subgraph" } }
      }
    },
    "pinType": {
      "type": "string",
      "enum": ["Any", "Param", "SpatialPoint", "SpatialSpline", "SpatialSurface", "SpatialMesh", "SpatialGeometry", "Texture", "HeightField", "Material"]
    },
    "subgraphPort": {
      "type": "object",
      "required": ["id", "name", "pinType"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "pinType": { "$ref": "#/$defs/pinType" },
        "anchorPlaced": { "type": "boolean" },
        "anchorX": { "type": "number" },
        "anchorY": { "type": "number" }
      }
    },
    "subgraphInterface": {
      "type": "object",
      "required": ["name", "inputs", "outputs"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/subgraphPort" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/subgraphPort" } }
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "position", "data"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "additionalProperties": false,
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "data": { "type": "object" },
        "subgraphInterface": { "$ref": "#/$defs/subgraphInterface" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "SubgraphAsset" } },
            "required": ["type"]
          },
          "then": {
            "required": ["subgraphInterface"],
            "properties": {
              "data": {
                "type": "object",
                "required": ["assetGuid"],
                "properties": {
                  "assetGuid": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" }
                }
              }
            }
          }
        }
      ]
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "sourceHandle": { "type": "string" },
        "targetHandle": { "type": "string" },
        "sourcePinType": { "$ref": "#/$defs/pinType" },
        "targetPinType": { "$ref": "#/$defs/pinType" }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["id", "name", "type", "default", "exposed", "targetNode", "targetProperty", "hasRange", "min", "max"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["integer", "number", "boolean", "string"] },
        "default": {},
        "exposed": { "type": "boolean" },
        "targetNode": { "type": "string" },
        "targetProperty": { "type": "string" },
        "hasRange": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "subgraph": {
      "type": "object",
      "required": ["id", "name", "inputs", "outputs", "parameters", "nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/subgraphPort" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/subgraphPort" } },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
      }
    }
  }
}
