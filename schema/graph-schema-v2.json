{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcg.example.com/graph-schema-v2.json",
  "title": "PCG Graph JSON v2",
  "description": "UE PCG-aligned graph contract with typed pins (Phase 4.0)",
  "type": "object",
  "required": ["version", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "2.0"
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "pinType": {
      "type": "string",
      "enum": ["Any", "Param", "SpatialPoint", "SpatialSpline", "SpatialSurface", "SpatialMesh", "Texture", "HeightField"]
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "position", "data"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "data": { "type": "object" }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target", "sourceHandle", "targetHandle"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "sourceHandle": { "type": "string" },
        "targetHandle": { "type": "string" },
        "sourcePinType": { "$ref": "#/$defs/pinType" },
        "targetPinType": { "$ref": "#/$defs/pinType" }
      }
    }
  }
}
