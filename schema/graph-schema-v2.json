{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcg.example.com/graph-schema-v2.json",
  "title": "PCG Graph JSON v2",
  "description": "UE PCG-aligned graph contract with typed pins (Phase 4.0)",
  "type": "object",
  "required": ["version", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "2.0"
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "parameters": {
      "type": "array",
      "items": { "$ref": "#/$defs/parameter" }
    },
    "subgraphs": {
      "type": "array",
      "items": { "$ref": "#/$defs/subgraph" }
    }
  },
  "$defs": {
    "pinType": {
      "type": "string",
      "enum": ["Any", "Param", "SpatialPoint", "SpatialSpline", "SpatialSurface", "SpatialMesh", "SpatialGeometry", "Texture", "HeightField"]
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "position", "data"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "data": { "type": "object" }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target", "sourceHandle", "targetHandle"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "sourceHandle": { "type": "string" },
        "targetHandle": { "type": "string" },
        "sourcePinType": { "$ref": "#/$defs/pinType" },
        "targetPinType": { "$ref": "#/$defs/pinType" }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["id", "name", "type", "default", "exposed", "targetNode", "targetProperty"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["integer", "number", "boolean", "string"] },
        "default": {},
        "exposed": { "type": "boolean" },
        "targetNode": { "type": "string" },
        "targetProperty": { "type": "string" },
        "hasRange": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "subgraphPort": {
      "type": "object",
      "required": ["id", "name", "pinType"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "pinType": { "$ref": "#/$defs/pinType" }
      }
    },
    "subgraph": {
      "type": "object",
      "required": ["id", "name", "inputs", "outputs", "nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/subgraphPort" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/subgraphPort" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
      }
    }
  }
}
