{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcg.example.com/graph-schema-v1.json",
  "title": "PCG Graph JSON v1",
  "description": "Manifest-driven compatibility contract between Web, C++ core, and Unity",
  "type": "object",
  "required": ["version", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version"
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "parameters": {
      "type": "array",
      "description": "Graph-level parameters exposed to the runtime Inspector",
      "items": { "$ref": "#/$defs/parameter" }
    },
    "subgraphs": {
      "type": "array",
      "description": "Inline reusable graph definitions. Subgraph instance nodes reference these by data.subgraphId.",
      "items": { "$ref": "#/$defs/subgraph" }
    }
  },
  "$defs": {
    "pinType": {
      "type": "string",
      "enum": ["Any", "Param", "SpatialPoint", "SpatialSpline", "SpatialSurface", "SpatialMesh", "Texture", "HeightField"]
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "position", "data"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique node identifier"
        },
        "type": {
          "type": "string",
          "description": "Node type is resolved through schema/node-manifest.json; structural subgraph node types are parser built-ins"
        },
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "data": { "type": "object" }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "sourceHandle": { "type": "string" },
        "targetHandle": { "type": "string" },
        "sourcePinType": { "$ref": "#/$defs/pinType" },
        "targetPinType": { "$ref": "#/$defs/pinType" }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["id", "name", "type", "default", "exposed", "targetNode", "targetProperty"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "Unique parameter identifier" },
        "name": { "type": "string", "description": "Display name shown in Inspector" },
        "type": { "type": "string", "enum": ["integer", "number", "boolean", "string"] },
        "default": { "description": "Default value (type depends on 'type' field)" },
        "exposed": { "type": "boolean", "default": true, "description": "Whether to show on runtime Inspector" },
        "targetNode": { "type": "string", "description": "Node ID whose property this parameter overrides" },
        "targetProperty": { "type": "string", "description": "Property key in the target node's data" },
        "hasRange": { "type": "boolean" },
        "min": { "type": "number" },
        "max": { "type": "number" }
      }
    },
    "subgraphPort": {
      "type": "object",
      "required": ["id", "name", "pinType"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "pinType": { "$ref": "#/$defs/pinType" }
      }
    },
    "subgraph": {
      "type": "object",
      "required": ["id", "name", "inputs", "outputs", "nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/subgraphPort" } },
        "outputs": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "$ref": "#/$defs/subgraphPort" } },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" },
          "contains": { "properties": { "type": { "const": "Output" } }, "required": ["type"] },
          "minContains": 1,
          "maxContains": 1
        },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
      }
    }
  }
}
