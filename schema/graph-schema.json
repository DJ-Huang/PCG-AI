{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcg.example.com/graph-schema-v1.json",
  "title": "PCG Graph JSON v1",
  "description": "Contract between Web editor, C++ core, and Unity plugin",
  "type": "object",
  "required": ["version", "nodes", "edges"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version"
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    },
    "parameters": {
      "type": "array",
      "description": "Graph-level parameters exposed to the runtime Inspector",
      "items": { "$ref": "#/$defs/parameter" }
    },
    "subgraphs": {
      "type": "array",
      "description": "Inline reusable graph definitions. Subgraph instance nodes reference these by data.subgraphId.",
      "items": { "$ref": "#/$defs/subgraph" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type", "position", "data"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique node identifier"
        },
        "type": {
          "type": "string",
          "enum": ["ParseConfig", "SpawnPoints", "PlaceInScene"],
          "description": "Node type determines which Block executes"
        },
        "position": {
          "type": "object",
          "required": ["x", "y"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        },
        "data": {
          "oneOf": [
            { "$ref": "#/$defs/ParseConfigData" },
            { "$ref": "#/$defs/SpawnPointsData" },
            { "$ref": "#/$defs/PlaceInSceneData" }
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "source", "target"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "source": { "type": "string" },
        "target": { "type": "string" },
        "sourceHandle": { "type": "string" },
        "targetHandle": { "type": "string" }
      }
    },
    "ParseConfigData": {
      "type": "object",
      "title": "ParseConfig",
      "properties": {
        "seed": { "type": "integer", "default": 42 },
        "density": { "type": "number", "default": 0.5, "minimum": 0, "maximum": 1 }
      }
    },
    "SpawnPointsData": {
      "type": "object",
      "title": "SpawnPoints",
      "properties": {
        "count": { "type": "integer", "default": 100, "minimum": 0 },
        "radius": { "type": "number", "default": 10.0, "minimum": 0 }
      }
    },
    "PlaceInSceneData": {
      "type": "object",
      "title": "PlaceInScene",
      "properties": {
        "prefab": { "type": "string", "default": "" },
        "scale": { "type": "number", "default": 1.0 }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["id", "name", "type", "default", "exposed", "targetNode", "targetProperty"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "description": "Unique parameter identifier" },
        "name": { "type": "string", "description": "Display name shown in Inspector" },
        "type": { "type": "string", "enum": ["integer", "number", "boolean", "string"] },
        "default": { "description": "Default value (type depends on 'type' field)" },
        "exposed": { "type": "boolean", "default": true, "description": "Whether to show on runtime Inspector" },
        "targetNode": { "type": "string", "description": "Node ID whose property this parameter overrides" },
        "targetProperty": { "type": "string", "description": "Property key in the target node's data" }
      }
    },
    "subgraphPort": {
      "type": "object",
      "required": ["id", "name", "pinType"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "pinType": { "type": "string" }
      }
    },
    "subgraph": {
      "type": "object",
      "required": ["id", "name", "inputs", "outputs", "nodes", "edges"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/subgraphPort" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/subgraphPort" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } }
      }
    }
  }
}
