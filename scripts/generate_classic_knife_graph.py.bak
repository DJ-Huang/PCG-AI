#!/usr/bin/env python3
"""Generate classic-knife.pcg from ClassicKnife alpha-traced loft stations."""
from __future__ import annotations

import json
from pathlib import Path

ROW = 160
COL = 320
SPINE = 200

ROOT = Path(__file__).resolve().parent.parent
DEMO = ROOT / "Unity/Assets/PcgPlugin/Examples/PCGDemo/classic-knife"
STATIONS = json.loads((DEMO / "refs/stations_loft.json").read_text())
ADAPTER = json.loads((DEMO / "refs/adapter_metrics.json").read_text())

FRONT_TEX = "Assets/PcgPlugin/Examples/PCGDemo/classic-knife/T_classic-knife_front_albedo.png"
BACK_TEX = "Assets/PcgPlugin/Examples/PCGDemo/classic-knife/T_classic-knife_back_aligned_albedo.png"


def cp(x: float, y: float, z: float) -> dict:
    return {"x": x, "y": y, "z": z}


def node(id_: str, typ: str, title: str, lane_x: int, row_y: int, data=None):
    d = {"__nodeTitle": title}
    if data:
        d.update(data)
    return {"id": id_, "type": typ, "position": {"x": lane_x, "y": row_y}, "data": d}


def edge(id_, src, tgt, sh="out", th="in"):
    return {"id": id_, "source": src, "target": tgt, "sourceHandle": sh, "targetHandle": th}


def profile_node(pid: str, title: str, x: float, yz, lane_x: int, row_y: int):
    pts = [cp(x, y, z) for y, z in yz]
    return node(pid, "CreateSpline", title, lane_x, row_y, {
        "mode": "catmullRom",
        "closed": True,
        "subdivisions": 10,
        "startX": x, "startY": 0, "startZ": 0,
        "endX": x, "endY": 0, "endZ": 0,
        "controlPoints": json.dumps(pts),
        "editPlane": "yz",
    })


def subgraph_body():
    """Silhouette loft from measured YZ stations (scallops/choil/staircase in profile)."""
    nodes, edges = [], []
    lx = SPINE
    pids = []
    for i, s in enumerate(STATIONS):
        pid = f"body_profile_{i}"
        pids.append(pid)
        # Pack profiles in a grid for GraphView readability
        col = i % 7
        row = i // 7
        nodes.append(profile_node(pid, f"Body Prof {i}", s["x"], s["yz"], lx + col * COL, row * ROW))

    loft_row = (len(STATIONS) // 7 + 1) * ROW
    nodes.append(node("body_loft", "LoftMesh", "Body Silhouette Loft", lx + 3 * COL, loft_row, {
        "columns": 20, "sortAxis": "x", "closedProfile": True,
        "capStart": True, "capEnd": True, "autoAlign": True, "shadeMode": "auto",
    }))
    for i, pid in enumerate(pids):
        edges.append(edge(f"e_body_p{i}", pid, "body_loft", "out", "profiles"))

    r = loft_row + ROW
    nodes.append(node("body_subdiv", "SubdivideMesh", "Body Subdiv", lx + 3 * COL, r, {"levels": 1}))
    edges.append(edge("e_body_sd", "body_loft", "body_subdiv"))
    r += ROW
    nodes.append(node("body_bevel", "BevelMesh", "Body Bevel", lx + 3 * COL, r, {
        "amount": 0.00055, "segments": 2,
    }))
    edges.append(edge("e_body_bv", "body_subdiv", "body_bevel"))

    # Lanyard bore cutter
    r += ROW
    ly = ADAPTER["Lanyard"]
    nodes.append(node("lanyard_cutter", "CreateCylinderMesh", "Lanyard Cutter", lx + 2 * COL, r, {
        "radius": ly["radius"], "height": 0.028, "radialSegments": 20, "heightSegments": 1,
    }))
    nodes.append(node("lanyard_xf", "TransformMesh", "Lanyard Place", lx + 2 * COL, r + ROW, {
        "translateX": ly["x"], "translateY": ly["y"], "translateZ": 0,
        "rotateX": 90, "rotateY": 0, "rotateZ": 0,
        "scaleX": 1, "scaleY": 1, "scaleZ": 1,
    }))
    edges.append(edge("e_lan_xf", "lanyard_cutter", "lanyard_xf"))
    nodes.append(node("lanyard_bool", "BooleanMesh", "Lanyard Bore", lx + 3 * COL, r + ROW, {
        "operation": "subtract", "treatAAs": "solid", "treatBAs": "solid",
    }))
    edges.append(edge("e_lan_a", "body_bevel", "lanyard_bool", "out", "a"))
    edges.append(edge("e_lan_b", "lanyard_xf", "lanyard_bool", "out", "b"))

    r2 = r + ROW * 2
    nodes.append(node("body_mat", "AssignMaterial", "Fade Body Mat", lx + 3 * COL, r2, {
        "materialName": "fade_blade",
    }))
    edges.append(edge("e_body_mat", "lanyard_bool", "body_mat"))
    nodes.append(node("body_out", "SubgraphOutput", "Body Out", lx + 3 * COL, r2 + ROW))
    edges.append(edge("e_body_out", "body_mat", "body_out", "out", "mesh"))
    return nodes, edges


def subgraph_tang():
    """Through-tang: thinner core tenoned under furniture (inferred Z)."""
    nodes, edges = [], []
    lx = SPINE
    length = ADAPTER["GuardX"] + 0.02
    nodes.append(node("tang_box", "CreateBoxMesh", "Through Tang", lx, 0, {
        "width": length, "height": 0.012, "depth": 0.0045,
    }))
    nodes.append(node("tang_xf", "TransformMesh", "Tang Place", lx, ROW, {
        "translateX": length * 0.5, "translateY": -0.001, "translateZ": 0,
        "rotateX": 0, "rotateY": 0, "rotateZ": 0,
        "scaleX": 1, "scaleY": 1, "scaleZ": 1,
    }))
    edges.append(edge("e_tang_xf", "tang_box", "tang_xf"))
    nodes.append(node("tang_subdiv", "SubdivideMesh", "Tang Subdiv", lx, ROW * 2, {"levels": 1}))
    edges.append(edge("e_tang_sd", "tang_xf", "tang_subdiv"))
    nodes.append(node("tang_bevel", "BevelMesh", "Tang Bevel", lx, ROW * 3, {
        "amount": 0.0004, "segments": 1,
    }))
    edges.append(edge("e_tang_bv", "tang_subdiv", "tang_bevel"))
    nodes.append(node("tang_mat", "AssignMaterial", "Tang Mat", lx, ROW * 4, {
        "materialName": "dark_furniture",
    }))
    edges.append(edge("e_tang_mat", "tang_bevel", "tang_mat"))
    nodes.append(node("tang_out", "SubgraphOutput", "Tang Out", lx, ROW * 5))
    edges.append(edge("e_tang_out", "tang_mat", "tang_out", "out", "mesh"))
    return nodes, edges


def subgraph_ferrule():
    """Gold beaded ferrule band at measured X."""
    import math
    nodes, edges = [], []
    lx = SPINE
    fx = ADAPTER["FerruleX"]
    fw = ADAPTER.get("FerruleWidth", 0.0024)
    hz = ADAPTER["HandleHalfThickness"] + 0.0008
    nodes.append(node("ferrule_band", "CreateCylinderMesh", "Ferrule Band", lx, 0, {
        "radius": hz, "height": fw, "radialSegments": 24, "heightSegments": 1,
    }))
    nodes.append(node("ferrule_xf", "TransformMesh", "Ferrule Place", lx, ROW, {
        "translateX": fx, "translateY": 0, "translateZ": 0,
        "rotateX": 0, "rotateY": 0, "rotateZ": 90,
        "scaleX": 1, "scaleY": 1.15, "scaleZ": 1,
    }))
    edges.append(edge("e_fer_xf", "ferrule_band", "ferrule_xf"))

    n = int(ADAPTER.get("BeadCount", 18))
    br = ADAPTER.get("BeadRadius", 0.00045)
    ring_r = hz + br * 0.5
    ring_pts = []
    for i in range(12):
        ang = 2 * math.pi * i / 12
        ring_pts.append(cp(fx, math.sin(ang) * ring_r, math.cos(ang) * ring_r))
    nodes.append(node("bead_ring", "CreateSpline", "Bead Ring Path", lx + COL, 0, {
        "mode": "catmullRom", "closed": True, "subdivisions": 12,
        "startX": fx, "startY": 0, "startZ": ring_r,
        "endX": fx, "endY": 0, "endZ": ring_r,
        "controlPoints": json.dumps(ring_pts),
        "editPlane": "yz",
    }))
    nodes.append(node("bead_proto", "CreateCylinderMesh", "Bead Proto", lx + COL * 2, 0, {
        "radius": max(br, 0.0011), "height": max(br * 1.6, 0.0012), "radialSegments": 8, "heightSegments": 1,
    }))
    circ = 2 * math.pi * ring_r
    nodes.append(node("bead_inst", "InstanceAlongSpline", "Bead Instances", lx + COL, ROW, {
        "spacing": circ / n, "offset": 0.0, "includeEnd": False,
        "alignToTangent": True, "scale": 1.0,
    }))
    edges.append(edge("e_bead_path", "bead_ring", "bead_inst", "out", "spline"))
    edges.append(edge("e_bead_mesh", "bead_proto", "bead_inst", "out", "mesh"))

    nodes.append(node("ferrule_band_bevel", "BevelMesh", "Ferrule Band Bevel", lx, ROW * 2, {
        "amount": 0.00025, "segments": 1,
    }))
    edges.append(edge("e_fer_bv", "ferrule_xf", "ferrule_band_bevel"))

    nodes.append(node("ferrule_merge", "MergeMesh", "Ferrule Merge", lx + COL, ROW * 2))
    edges.append(edge("e_fer_m0", "ferrule_band_bevel", "ferrule_merge"))
    edges.append(edge("e_fer_m1", "bead_inst", "ferrule_merge"))
    nodes.append(node("ferrule_mat", "AssignMaterial", "Ferrule Gold Mat", lx + COL, ROW * 3, {
        "materialName": "gold_ferrule",
    }))
    edges.append(edge("e_fer_mat", "ferrule_merge", "ferrule_mat"))
    nodes.append(node("ferrule_out", "SubgraphOutput", "Ferrule Out", lx + COL, ROW * 4))
    edges.append(edge("e_fer_out", "ferrule_mat", "ferrule_out", "out", "mesh"))
    return nodes, edges


def subgraph_hardware():
    """Four countersunk screws at measured bolster coordinates."""
    nodes, edges = [], []
    lx = SPINE
    screws = list(ADAPTER["FrontScrews"]) + list(ADAPTER["RearScrews"])
    sr = ADAPTER.get("ScrewRadius", 0.0015)
    cs = ADAPTER.get("ScrewCountersink", 0.0022)
    part_ids = []
    for i, s in enumerate(screws):
        lane = lx + i * COL
        shaft = f"screw_shaft_{i}"
        nodes.append(node(shaft, "CreateCylinderMesh", f"Screw Shaft {i}", lane, 0, {
            "radius": max(sr * 0.7, 0.0011), "height": 0.022, "radialSegments": 12, "heightSegments": 1,
        }))
        nodes.append(node(f"{shaft}_xf", "TransformMesh", f"Screw Shaft {i} Place", lane, ROW, {
            "translateX": s["x"], "translateY": s["y"], "translateZ": 0,
            "rotateX": 90, "rotateY": 0, "rotateZ": 0,
            "scaleX": 1, "scaleY": 1, "scaleZ": 1,
        }))
        edges.append(edge(f"e_ss_{i}", shaft, f"{shaft}_xf"))
        part_ids.append(f"{shaft}_xf")
        for si, (side, z) in enumerate((("p", ADAPTER["HandleHalfThickness"] + 0.0002),
                                        ("n", -(ADAPTER["HandleHalfThickness"] + 0.0002)))):
            head = f"screw_head_{i}_{side}"
            hlane = lane + si * (COL // 2)
            nodes.append(node(head, "CreateCylinderMesh", f"Screw Head {i}{side}", hlane, ROW * 2 + si * ROW, {
                "radius": max(cs, 0.0015), "height": 0.0012, "radialSegments": 12, "heightSegments": 1,
            }))
            xf = f"{head}_xf"
            nodes.append(node(xf, "TransformMesh", f"Screw Head {i}{side} Place", hlane, ROW * 4 + si * ROW, {
                "translateX": s["x"], "translateY": s["y"], "translateZ": z,
                "rotateX": 90, "rotateY": 0, "rotateZ": 0,
                "scaleX": 1, "scaleY": 1, "scaleZ": 1,
            }))
            edges.append(edge(f"e_sh_{i}_{side}", head, xf))
            part_ids.append(xf)

    nodes.append(node("hw_merge", "MergeMesh", "Hardware Merge", lx + COL * 2, ROW * 8))
    for i, pid in enumerate(part_ids):
        edges.append(edge(f"e_hw_{i}", pid, "hw_merge"))
    nodes.append(node("hw_mat", "AssignMaterial", "Hardware Mat", lx + COL * 2, ROW * 9, {
        "materialName": "dark_furniture",
    }))
    edges.append(edge("e_hw_mat", "hw_merge", "hw_mat"))
    nodes.append(node("hw_out", "SubgraphOutput", "Hardware Out", lx + COL * 2, ROW * 10))
    edges.append(edge("e_hw_out", "hw_mat", "hw_out", "out", "mesh"))
    return nodes, edges


def subgraph_quilt():
    """Diamond-quilt relief on grip faces — sparse identity cue."""
    nodes, edges = [], []
    lx = SPINE
    pitch = 0.004
    ids = []
    for i, (x, y) in enumerate([(0.045, 0.0)]):
        for si, (sign, suffix) in enumerate(((1, "f"), (-1, "b"))):
            bid = f"quilt_{i}_{suffix}"
            lane = lx + si * COL
            nodes.append(node(bid, "CreateBoxMesh", f"Quilt {i}{suffix}", lane, 0, {
                "width": pitch, "height": pitch, "depth": 0.0011,
            }))
            xf = f"{bid}_xf"
            nodes.append(node(xf, "TransformMesh", f"Quilt {i}{suffix} Place", lane, ROW, {
                "translateX": x, "translateY": y,
                "translateZ": sign * (ADAPTER["HandleHalfThickness"] + 0.0002),
                "rotateX": 0, "rotateY": 0, "rotateZ": 45,
                "scaleX": 1, "scaleY": 1, "scaleZ": 1,
            }))
            edges.append(edge(f"e_q_{i}_{suffix}", bid, xf))
            bv = f"{bid}_bv"
            nodes.append(node(bv, "BevelMesh", f"Quilt {i}{suffix} Bevel", lane, ROW * 2, {
                "amount": 0.0003, "segments": 1,
            }))
            edges.append(edge(f"e_qbv_{i}_{suffix}", xf, bv))
            ids.append(bv)

    nodes.append(node("quilt_merge", "MergeMesh", "Quilt Merge", lx + COL, ROW * 3))
    for i, pid in enumerate(ids):
        edges.append(edge(f"e_qm_{i}", pid, "quilt_merge"))
    nodes.append(node("quilt_mat", "AssignMaterial", "Quilt Mat", lx + COL, ROW * 4, {
        "materialName": "grip_polymer",
    }))
    edges.append(edge("e_quilt_mat", "quilt_merge", "quilt_mat"))
    nodes.append(node("quilt_out", "SubgraphOutput", "Quilt Out", lx + COL, ROW * 5))
    edges.append(edge("e_quilt_out", "quilt_mat", "quilt_out", "out", "mesh"))
    return nodes, edges


def build():
    body_n, body_e = subgraph_body()
    tang_n, tang_e = subgraph_tang()
    fer_n, fer_e = subgraph_ferrule()
    hw_n, hw_e = subgraph_hardware()
    quilt_n, quilt_e = subgraph_quilt()

    subgraphs = [
        {"id": "blade_body", "name": "Blade Body", "inputs": [],
         "outputs": [{"id": "mesh", "name": "Mesh", "pinType": "SpatialMesh"}],
         "nodes": body_n, "edges": body_e},
        {"id": "tang_core", "name": "Through Tang", "inputs": [],
         "outputs": [{"id": "mesh", "name": "Mesh", "pinType": "SpatialMesh"}],
         "nodes": tang_n, "edges": tang_e},
        {"id": "ferrule", "name": "Beaded Ferrule", "inputs": [],
         "outputs": [{"id": "mesh", "name": "Mesh", "pinType": "SpatialMesh"}],
         "nodes": fer_n, "edges": fer_e},
        {"id": "hardware", "name": "Countersunk Screws", "inputs": [],
         "outputs": [{"id": "mesh", "name": "Mesh", "pinType": "SpatialMesh"}],
         "nodes": hw_n, "edges": hw_e},
        {"id": "quilt_grip", "name": "Quilt Grip", "inputs": [],
         "outputs": [{"id": "mesh", "name": "Mesh", "pinType": "SpatialMesh"}],
         "nodes": quilt_n, "edges": quilt_e},
    ]

    root_nodes = [
        node("sg_body", "Subgraph", "Blade Body Module", SPINE, 0, {"subgraphId": "blade_body"}),
        node("sg_tang", "Subgraph", "Tang Module", SPINE + COL, 0, {"subgraphId": "tang_core"}),
        node("sg_ferrule", "Subgraph", "Ferrule Module", SPINE + COL * 2, 0, {"subgraphId": "ferrule"}),
        node("sg_hw", "Subgraph", "Hardware Module", SPINE + COL * 3, 0, {"subgraphId": "hardware"}),
        node("sg_quilt", "Subgraph", "Quilt Module", SPINE, ROW, {"subgraphId": "quilt_grip"}),
        node("assembly_merge", "MergeMesh", "Knife Assembly", SPINE + COL, ROW * 2),
        node("uv_planar", "UVTexture", "Shared Planar UV", SPINE + COL, ROW * 3, {
            "projection": "planar", "axis": "z",
            "scaleU": ADAPTER["OverallLength"], "scaleV": ADAPTER["OverallHeight"],
            "offsetU": 0.0, "offsetV": 0.0,
        }),
        node("front_tex", "ImageTexture", "Front Fade Albedo", SPINE - COL, ROW * 3, {
            "texture": FRONT_TEX, "repeatX": 1.0, "repeatY": 1.0,
        }),
        node("back_tex", "ImageTexture", "Back Fade Albedo", SPINE - COL, ROW * 4, {
            "texture": BACK_TEX, "repeatX": 1.0, "repeatY": 1.0,
        }),
        node("project_front", "ProjectTexture", "Project Front Fade", SPINE + COL, ROW * 4, {
            "direction": "z",
            "scaleU": ADAPTER["OverallLength"],
            "scaleV": ADAPTER["OverallHeight"],
            "offsetU": 0.0, "offsetV": 0.0,
        }),
        node("out", "Output", "Output", SPINE + COL, ROW * 5, {"label": "CS2 Classic Knife Fade"}),
    ]
    root_edges = [
        edge("e_sg_body", "sg_body", "assembly_merge", "mesh", "in"),
        edge("e_sg_tang", "sg_tang", "assembly_merge", "mesh", "in"),
        edge("e_sg_fer", "sg_ferrule", "assembly_merge", "mesh", "in"),
        edge("e_sg_hw", "sg_hw", "assembly_merge", "mesh", "in"),
        edge("e_sg_quilt", "sg_quilt", "assembly_merge", "mesh", "in"),
        edge("e_merge_uv", "assembly_merge", "uv_planar"),
        edge("e_uv_proj", "uv_planar", "project_front"),
        edge("e_tex_proj", "front_tex", "project_front", "out", "texture"),
        edge("e_proj_out", "project_front", "out"),
    ]

    # Root-only Graph Parameters (Inspector). Subgraph interior bindings unsupported.
    parameters = [
        {
            "id": "p_scale_u", "name": "FadeScaleU", "type": "number",
            "default": ADAPTER["OverallLength"],
            "exposed": True, "targetNode": "project_front", "targetProperty": "scaleU",
            "hasRange": True, "min": 0.15, "max": 0.35,
        },
        {
            "id": "p_scale_v", "name": "FadeScaleV", "type": "number",
            "default": ADAPTER["OverallHeight"],
            "exposed": True, "targetNode": "project_front", "targetProperty": "scaleV",
            "hasRange": True, "min": 0.02, "max": 0.06,
        },
        {
            "id": "p_off_u", "name": "FadeOffsetU", "type": "number", "default": 0.0,
            "exposed": True, "targetNode": "project_front", "targetProperty": "offsetU",
            "hasRange": True, "min": -0.05, "max": 0.05,
        },
    ]

    return {
        "version": "1.0",
        "parameters": parameters,
        "nodes": root_nodes,
        "edges": root_edges,
        "subgraphs": subgraphs,
    }


def main():
    doc = build()
    text = json.dumps(doc, indent=2) + "\n"
    paths = [
        ROOT / "examples" / "classic-knife.pcg",
        DEMO / "classic-knife.pcg",
    ]
    for p in paths:
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(text)
        print(f"Wrote {p} root={len(doc['nodes'])} subgraphs={len(doc['subgraphs'])}")


if __name__ == "__main__":
    main()
