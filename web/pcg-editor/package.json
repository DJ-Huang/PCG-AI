{
  "name": "pcg-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:agent": "vitest run src/agent src/SettingsDialog.test.tsx",
    "test:graph-commands": "node scripts/validate-graph-commands.mjs",
    "test:pbr": "python3 ../../scripts/validate-web-pbr.py",
    "test:environments": "python3 ../../scripts/validate-builtin-environments.py",
    "test:preview-parameters": "python3 ../../scripts/validate-web-preview-parameters.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^27.0.1",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.2.7"
  }
}
